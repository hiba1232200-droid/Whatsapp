# انسخ هذا الملف إلى .env للتشغيل المحلي، أو أضِف هذه المتغيّرات في Railway > Variables.

# مسار تخزين البيانات الثابتة. على Railway اجعله مساوياً لمسار الـ Volume (مثلاً /data).
DATA_DIR=/data

# رقم هاتف البوت للربط عبر رمز الاقتران (بصيغة دولية بدون + وبدون 00).
# مثال لسوريا: 9639XXXXXXXX — اتركه فارغاً لاستخدام QR بدلاً منه.
PAIRING_NUMBER=

# بادئة الأوامر (اختياري)
PREFIX=!

# عدد الأعضاء في !top (اختياري)
TOP_LIMIT=10

# اقصر البوت على مجموعات محددة، معرّفات مفصولة بفواصل (اختياري)
# ALLOWED_GROUPS=1203630xxxxxxxxx@g.us,1203631xxxxxxxxx@g.us

# احتساب الانضمام عبر رابط الدعوة كإضافة؟ true/false (اختياري، الافتراضي false)
COUNT_INVITE_JOINS=false
